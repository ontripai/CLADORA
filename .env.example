# =============================================================================
# CLADORA Platform Environment Variables Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PUBLIC SITE & CLIENT SUPABASE CONFIGURATION (Development, Preview, Production)
# -----------------------------------------------------------------------------
# Canonical production site URL. Defaults to https://cladora.ro.
NEXT_PUBLIC_SITE_URL=https://cladora.ro

# Client-safe Supabase connection keys (Supabase Dashboard > Settings > API).
# Use publishable key, NEVER service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Cloudflare Turnstile Site Key for browser challenge rendering.
# (Optional in local development; required in production if TURNSTILE_REQUIRED=true)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# 2. SERVER-SIDE CREDENTIALS & SECURITY SECRETS (Preview, Production)
# -----------------------------------------------------------------------------
# CLI / Migration metadata only.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Server-only Supabase Service Secret Key for administrative database operations and RLS bypass.
# Never expose to browser code or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET_KEY

# HMAC-SHA256 secret key for privacy-safe IP hashing and lead fingerprinting.
# Minimum 32 characters. Required in Production and Preview.
# Generate with: openssl rand -hex 32
LEAD_IP_HASH_SECRET=

# -----------------------------------------------------------------------------
# 3. CLOUDFLARE TURNSTILE & ANTI-SPAM (Preview, Production)
# -----------------------------------------------------------------------------
# Controls whether Turnstile verification is strictly required (fail-closed).
# Values: true | false. Default in production is true.
TURNSTILE_REQUIRED=true

# Server-side secret key for Turnstile /siteverify endpoint.
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 4. LEAD NOTIFICATIONS & SSRF DEFENSES (Optional, Preview, Production)
# -----------------------------------------------------------------------------
# HTTPS Webhook destination URL for dispatching new lead notifications.
# Must use HTTPS. Private IP blocks and local loopbacks are automatically rejected.
CONTACT_NOTIFICATION_WEBHOOK_URL=

# Comma-separated list of allowed hostnames for the notification webhook.
# Example: hooks.slack.com,discord.com,api.postmarkapp.com
CONTACT_NOTIFICATION_ALLOWED_HOSTS=

# Optional bearer API key for outbound webhook authentication.
EMAIL_PROVIDER_API_KEY=

# -----------------------------------------------------------------------------
# 5. FORM ORIGIN CONTROLS & ROUTE GATING (Development, Preview, Production)
# -----------------------------------------------------------------------------
# Optional comma-separated list of additional trusted origins allowed to submit forms.
# Defaults to https://cladora.ro and current Vercel deployment preview URL.
ALLOWED_FORM_ORIGINS=

# Set to "true" to allow access to internal development routes (wireframes, prototype)
# in production mode. Defaults to false (routes return 404).
ENABLE_INTERNAL_ROUTES=false

# Offline development flag allowing mock lead capture and mock secrets.
# Strictly ignored in production/preview.
ALLOW_DEV_FALLBACK_SECRET=false
ALLOW_MOCK_LEAD_CAPTURE=false

# -----------------------------------------------------------------------------
# 6. LEGAL & CORPORATE REGISTRATION METADATA (Optional)
# -----------------------------------------------------------------------------
# Official registered company details. Used on legal pages (/terms, /privacy, /cookies).
LEGAL_COMPANY_NAME=
LEGAL_CUI=
LEGAL_TRADE_REGISTER_NUMBER=
LEGAL_REGISTERED_ADDRESS=
LEGAL_DPO_CONTACT=
