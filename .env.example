# Browser-safe values from Supabase Project > Connect > Next.js.
# Use the new publishable key (sb_publishable_...), not service_role or secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# CLI metadata only. Keep database passwords and access tokens in secret stores.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
