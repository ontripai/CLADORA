# Browser-safe values from Supabase Project > Connect > Next.js.
# Use the new publishable key (sb_publishable_...), not service_role or secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional until Cloudflare Turnstile is enabled in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# CLI metadata only. Keep database passwords and access tokens in secret stores.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Server-only values. Configure only in encrypted environment settings.
# Never prefix these variables with NEXT_PUBLIC_ and never expose them to browser code.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET_KEY
APP_ORIGIN=https://cladora-website.vercel.app
